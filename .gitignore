# Dataset files (excluded per user instruction)
Dataset/
**/Dataset/
UNet-Mamba Extension/Dataset/
UNet-Mamba/Dataset/
*.tif
*.tiff

# Heavy binary dataset arrays and precomputed caches (>2GB)
UNet-Mamba/manifests/processed_data/
UNet-Mamba Extension/manifests/processed_data/
processed_data/
*.npz

# Large baseline model weights (>100MB, exceeds GitHub 100MB limit)
UNet-Mamba/checkpoints/*.pth
!UNet-Mamba/checkpoints/.gitkeep
UNet-Mamba Extension/checkpoints/best_model.pth
UNet-Mamba Extension/checkpoints/final_epoch_11.pth
UNet-Mamba Extension/checkpoints/last_checkpoint.pth
!UNet-Mamba Extension/checkpoints/.gitkeep

# Large release bundles and archives (>100MB, exceeds GitHub 100MB limit)
*.zip
UNet-Mamba/releases/*.zip
UNet-Mamba Extension/releases/*.zip

